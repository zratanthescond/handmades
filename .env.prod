# Production environment variables
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=your_app_secret_here_change_this

# Database
DATABASE_URL=postgresql://symfony:symfony@db:5432/handmades_db

# Mailer
MAILER_DSN=smtp://localhost

# JWT Authentication
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=your_jwt_passphrase_here

# Redis (for sessions/cache)
REDIS_URL=redis://redis:6379

# CORS
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$

# File uploads
MAX_FILE_SIZE=10M

# API Platform
API_PLATFORM_TITLE="Handmades API"
API_PLATFORM_DESCRIPTION="API for Handmades application"
API_PLATFORM_VERSION=1.0.0

